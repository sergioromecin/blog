<div id="<%= dom_id post %>">
  <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-stone-400">
    <%= time_tag post.updated_at, "data-local": "time", "data_format": "%B %e, %Y" %>
  </p>
  <h2 class="text-2xl font-black leading-tight tracking-tight text-stone-950 sm:text-3xl"><%= post.title.presence || "Untitled note" %></h2>
  <div class="mt-5 line-clamp-4 text-base leading-7 text-stone-600 trix-content"><%= post.body %></div>
</div>
