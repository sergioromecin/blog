<% if notice %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"><%= notice %></div>
<% end %>

<article class="mx-auto max-w-3xl">
  <div class="mb-10 flex items-center justify-between gap-4">
    <%= link_to "← All notes", posts_path, class: "text-sm font-bold text-stone-500 transition hover:text-stone-950" %>
    <%= link_to "Edit", edit_post_path(@post), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-bold text-stone-700 transition hover:border-stone-900 hover:text-stone-950" %>
  </div>

  <div class="rounded-[2rem] border border-stone-200 bg-white p-7 shadow-sm sm:p-12">
    <%= render @post %>
    <div class="mt-10 border-t border-stone-100 pt-8 text-sm text-stone-500">
      <%= button_to "Delete this note", @post, method: :delete, class: "font-semibold text-red-600 transition hover:text-red-800", form: { data: { turbo_confirm: "Delete this note permanently?" } } %>
    </div>
  </div>

  <div class="mt-10 rounded-[2rem] border border-stone-200 bg-stone-100/70 p-7 sm:p-10">
    <%= render "comments/comments", post: @post %>
  </div>
</article>
