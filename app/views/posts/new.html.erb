<% content_for :title, "New post" %>

<div class="mx-auto max-w-3xl">
  <div class="mb-10">
    <%= link_to "← Back to notes", posts_path, class: "text-sm font-bold text-stone-500 hover:text-stone-950" %>
    <h1 class="mt-6 text-4xl font-black tracking-tight text-stone-950">Write a new note</h1>
    <p class="mt-3 text-stone-500">Put something useful into the world.</p>
  </div>
  <div class="rounded-[2rem] border border-stone-200 bg-white p-7 shadow-sm sm:p-10">
    <%= render "form", post: @post %>
  </div>
</div>
