<% content_for :title, "Editing post" %>

<div class="mx-auto max-w-3xl">
  <div class="mb-10">
    <%= link_to "← Back to note", @post, class: "text-sm font-bold text-stone-500 hover:text-stone-950" %>
    <h1 class="mt-6 text-4xl font-black tracking-tight text-stone-950">Edit your note</h1>
  </div>
  <div class="rounded-[2rem] border border-stone-200 bg-white p-7 shadow-sm sm:p-10">
    <%= render "form", post: @post %>
  </div>
</div>
