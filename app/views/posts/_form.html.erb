<%= form_with(model: post, class: "space-y-7") do |form| %>
  <% if post.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <h2 class="font-bold"><%= pluralize(post.errors.count, "error") %> prohibited this note from being saved:</h2>

        <ul class="mt-2 list-disc pl-5">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Title", class: "mb-2 block text-sm font-bold text-stone-700" %>
    <%= form.text_field :title, class: "w-full rounded-2xl border-stone-300 bg-white px-4 py-3 text-lg shadow-sm outline-none transition placeholder:text-stone-400 focus:border-amber-500 focus:ring-4 focus:ring-amber-100", placeholder: "Give your note a clear title" %>
  </div>

  <div>
    <%= form.label :body, "Your note", class: "mb-2 block text-sm font-bold text-stone-700" %>
    <%= form.rich_textarea :body %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit post.persisted? ? "Save changes" : "Publish note", class: "cursor-pointer rounded-full bg-stone-900 px-6 py-3 text-sm font-bold text-white transition hover:bg-amber-500 hover:text-stone-950" %>
    <%= link_to "Cancel", post.persisted? ? post : posts_path, class: "text-sm font-bold text-stone-500 hover:text-stone-950" %>
  </div>
<% end %>
