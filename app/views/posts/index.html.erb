<% if notice %>
  <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"><%= notice %></div>
<% end %>

<% content_for :title, "Posts" %>

<section class="mb-12 max-w-2xl">
  <p class="mb-4 text-xs font-bold uppercase tracking-[0.28em] text-amber-600">Recent thinking</p>
  <h1 class="text-5xl font-black tracking-tight text-stone-950 sm:text-6xl">Notes for curious people.</h1>
  <p class="mt-5 text-lg leading-8 text-stone-600">Short essays, useful discoveries, and things worth returning to.</p>
</section>

<div id="posts" class="grid gap-6 md:grid-cols-2">
  <% @posts.each do |post| %>
    <article class="group flex min-h-64 flex-col justify-between rounded-3xl border border-stone-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-amber-300 hover:shadow-xl">
      <%= render post %>
      <%= link_to post, class: "mt-8 inline-flex items-center gap-2 text-sm font-bold text-stone-900" do %>
        Read note <span class="transition group-hover:translate-x-1">&rarr;</span>
      <% end %>
    </article>
  <% end %>
</div>
